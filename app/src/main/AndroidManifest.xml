<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        ====================================================================
        CONFIGURAZIONE APPLICAZIONE ANDROID & PREDICTIVE BACK GESTURE (API 34+)
        ====================================================================
        🧠 SPIEGAZIONE DIDATTICA E TECNICA:
        L'attributo `android:enableOnBackInvokedCallback="true"` segnala al sistema operativo Android (API 33+)
        che l'applicazione gestisce reattivamente le nuove API di navigazione predittiva (Predictive Back Gesture).
        Abilitando questa flag:
        1. Android attiva le anteprime visive in tempo reale (Predictive Back Animations) quando l'utente
           esegue il gesto dello swipe "Indietro" dal bordo dello schermo.
        2. Il sistema collega il WindowManager nativo al dispatcher di Jetpack Compose,
           permettendo a NavHost e ai componenti BackHandler di intercettare gli eventi OnBackStarted, OnBackProgressed,
           OnBackCancelled e OnBackInvoked in modo continuo e fluido.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ScoreCounter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScoreCounter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.ScoreWidgetReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/score_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.n380.scorecounter.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>