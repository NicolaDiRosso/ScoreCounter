    <string name="msg_vinca_il_migliore">Que le meilleur gagne !</string>
    <string name="msg_segnalazione_bug">Pour signaler des bugs ou envoyer des suggestions, appuyez sur le bouton et envoyez-moi un e-mail (en joignant des images ou des vidéos) 😊.</string>
