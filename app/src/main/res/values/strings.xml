    <string name="titolo_donazione">Support ScoreCounter</string>
    <string name="msg_donazione_saluto">Hi, I\'m Nicola! 👋</string>
    <string name="msg_donazione_intro">I\'m a Computer Engineering student. I created this app in my spare time to keep track of scores with my friends in a simple, beautiful, and clean way. It started as a small personal project, but I decided to share it with everyone.</string>
    <string name="msg_donazione_promessa">This app is and will always remain ad-free!</string>
    <string name="msg_donazione_scopo">If you\'d like to make a small donation (even just €1), you\'ll help me reach the €25 fee to officially publish ScoreCounter on the Play Store and let me know you appreciate my work.</string>
    <string name="msg_donazione_grazie">Thank you from the bottom of my heart just for giving my app a chance. It means the world to me. ❤️</string>
    <string name="btn_donazione_chiudi">Thanks!</string>
